# Copy to .env and point at your OpenAI-compatible endpoint(s) (Ollama / vLLM).
# Two endpoints let you keep one model resident per node (no load/unload thrash);
# set both to the same URL if you run a single node.
SPARK1_URL=http://localhost:11434/v1
SPARK2_URL=http://localhost:11434/v1
DRAFTER_MODEL=gemma4:12b-it-qat
CRITIC_MODEL=qwen3:30b
JUDGE_MODEL=qwen3:30b
